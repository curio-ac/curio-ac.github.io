 "emoji": "📜",
 "sentences": [
  "ילד מתבולל הפך לענק חקר הקבלה.",
  "גרשם שלום נולד בברלין למשפחה רחוקה מיהדות.",
  "בגיל 18 הוא כבר למד את הזוהר לבדו.",
  "הוא עלה לישראל וניהל את המחלקה ליהדות בבית הספרים הלאומי.",
  "שלום יצא לאירופה להציל ספרים שהוחרמו בתקופת השואה.",
  "במהלך חייו הוא פרסם כ-600 מחקרים על תורת הסוד היהודית."
 ],
