 "title": "Confederate Missouri Infantry Regiment",
 "cat": "history",
 "emoji": "⚔️",
 "sentences": [
  "This Confederate regiment formed on April 28, 1862.",
  "It missed action at the Battle of Farmington and the Battle of Iuka.",
  "The troops charged Union lines 3 times during the Second Battle of Corinth on October 3, 1862.",
  "Their next day attack was repulsed by a Union counterattack.",
  "The unit combined with the 1st Missouri Infantry Regiment on November 7, 1862.",
  "The combined unit later fought in the Vicksburg campaign and surrendered at the siege."
 ],
